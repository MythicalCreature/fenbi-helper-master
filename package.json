{
  "name": "fenbi",
  "version": "1.0.0",
  "description": "在备考过程中，你是否曾因找不到目标考题、错题整理繁琐、学习资料保存不便而烦恼？今天给大家分享一款专为考试刷题设计的node项目，无论是公务员考试、专项练习还是日常刷题，都能帮你大幅提升效率，让备考更轻松！",
  "main": "src/app.js",
  "bin": {
    "fenbi": "src/app.js"
  },
  "scripts": {
    "start": "node src/app.js",
    "build:win": "pkg . --targets node16-win-x64 --output my-koa-app.exe",
    "build:mac-intel": "pkg . --targets node16-macos-x64 --output fenbiHelper-intel",
    "build:mac-m": "pkg . --targets node16-macos-arm64 --output fenbiHelper-m",
    "build:all": "pkg . --targets node16-win-x64,node16-macos-x64,node16-macos-arm64 --out-path ./dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@koa/router": "^14.0.0",
    "axios": "^1.16.1",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.7",
    "docxtemplater-image-module-free": "^1.1.1",
    "ejs": "^3.1.3",
    "fs-extra": "^11.3.5",
    "html-docx-js": "^0.3.1",
    "koa": "^2.13.0",
    "koa-body": "^4.2.0",
    "koa-ejs": "^4.3.0",
    "koa-router": "^14.0.0",
    "koa-static": "^5.0.0",
    "libreoffice-convert": "^1.8.1",
    "lodash": "^4.17.15",
    "moment": "^2.27.0",
    "officegen": "^0.6.5",
    "percentile": "^1.4.0",
    "pizzip": "^3.2.0",
    "puppeteer-core": "^25.0.4",
    "qs": "^6.9.4",
    "request": "^2.88.2",
    "set-cookie-parser": "^2.4.6",
    "sharp": "^0.34.5",
    "uuid": "^8.x"
  },
  "pkg": {
    "assets": [
      "src/views/*.ejs",
      "src/service/*.js",
      "src/util/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "type": "commonjs"
}